generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COACH
  STUDENT
}

enum PuzzleType {
  AUTO
  MANUAL
}

enum ProgressStatus {
  PENDING
  IN_PROGRESS
  REVIEW_PENDING
  SOLVED
  FAILED
}

model User {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  password        String
  fullName        String
  lichessUsername String? // Нікнейм на Lichess для учнів
  role            Role     @default(STUDENT)
  createdAt       DateTime @default(now())

  createdAssignments Assignment[]      @relation("CoachAssignments")
  studentProgress    StudentProgress[]
}

model Assignment {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime @default(now())

  coachId Int
  coach   User @relation("CoachAssignments", fields: [coachId], references: [id])

  puzzles Puzzle[]

  progress StudentProgress[]
}

model Puzzle {
  id          Int          @id @default(autoincrement())
  title       String?
  type        PuzzleType   @default(AUTO)
  fen         String
  solution    String
  hint        String?
  tags        String[]
  assignments Assignment[]
  createdAt   DateTime     @default(now())

  puzzleStatuses StudentPuzzleStatus[]
}

model StudentProgress {
  id             Int            @id @default(autoincrement())
  studentId      Int
  assignmentId   Int
  status         ProgressStatus @default(PENDING)
  trainerComment String?        @db.Text
  completedAt    DateTime?

  puzzleStatuses StudentPuzzleStatus[]

  student    User       @relation(fields: [studentId], references: [id])
  assignment Assignment @relation(fields: [assignmentId], references: [id])

  @@unique([studentId, assignmentId])
}

model StudentPuzzleStatus {
  id         Int @id @default(autoincrement())
  progressId Int
  puzzleId   Int

  currentStep    Int     @default(0)
  isFirstTryFail Boolean @default(false)
  failStep       Int?
  isSolved       Boolean @default(false)
  studentAnswer  String? @db.Text

  progress StudentProgress @relation(fields: [progressId], references: [id])
  puzzle   Puzzle          @relation(fields: [puzzleId], references: [id])

  @@unique([progressId, puzzleId])
}
