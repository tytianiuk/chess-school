generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COACH
  STUDENT
}

enum CheckType {
  AUTO
  MANUAL
}

enum ProgressStatus {
  PENDING
  IN_PROGRESS
  REVIEW_PENDING
  SOLVED
  FAILED
}

model User {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  password        String
  fullName        String
  lichessUsername String?
  role            Role     @default(STUDENT)
  createdAt       DateTime @default(now())

  // Тренер
  createdHomeworks Homework[] @relation("CoachHomeworks")
  createdGroups    Group[]    @relation("CoachGroups")

  // Учень
  groupMemberships    GroupMember[]
  homeworkAnswers     HomeworkAnswer[]
  individualHomeworks Homework[] @relation("StudentHomeworks")

  // Зв'язок тренер-учень
  students User[]  @relation("CoachToStudent")
  coachId  Int?
  coach    User?   @relation("CoachToStudent", fields: [coachId], references: [id])
}

model Group {
  id        Int      @id @default(autoincrement())
  name      String
  coachId   Int
  createdAt DateTime @default(now())

  coach     User          @relation("CoachGroups", fields: [coachId], references: [id])
  members   GroupMember[]
  homeworks Homework[]
}

model GroupMember {
  id        Int @id @default(autoincrement())
  groupId   Int
  studentId Int

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id])

  @@unique([groupId, studentId])
}

model Puzzle {
  id        Int      @id @default(autoincrement())
  title     String?
  fen       String
  solution  String
  hint      String?
  tags      String[]
  createdAt DateTime @default(now())

  homeworkPuzzles HomeworkPuzzle[]
}

model Homework {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime @default(now())

  coachId Int
  coach   User @relation("CoachHomeworks", fields: [coachId], references: [id])

  // Групове або індивідуальне
  groupId   Int?
  group     Group? @relation(fields: [groupId], references: [id])
  studentId Int?
  student   User?  @relation("StudentHomeworks", fields: [studentId], references: [id])

  puzzles         HomeworkPuzzle[]
  homeworkAnswers HomeworkAnswer[]
}

model HomeworkPuzzle {
  id         Int       @id @default(autoincrement())
  homeworkId Int
  puzzleId   Int
  checkType  CheckType @default(AUTO)

  homework       Homework       @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  puzzle         Puzzle         @relation(fields: [puzzleId], references: [id])
  puzzleAttempts PuzzleAttempt[]

  @@unique([homeworkId, puzzleId])
}

model HomeworkAnswer {
  id         Int            @id @default(autoincrement())
  studentId  Int
  homeworkId Int
  status     ProgressStatus @default(PENDING)
  trainerComment String?    @db.Text
  score          Int?
  completedAt    DateTime?

  student  User     @relation(fields: [studentId], references: [id])
  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  puzzleAttempts PuzzleAttempt[]

  @@unique([studentId, homeworkId])
}

model PuzzleAttempt {
  id               Int @id @default(autoincrement())
  homeworkAnswerId Int
  homeworkPuzzleId Int

  currentStep   Int     @default(0)
  attemptCount  Int     @default(0)
  solvedOnFirst Boolean @default(false)
  isSolved      Boolean @default(false)
  studentAnswer String? @db.Text

  homeworkAnswer HomeworkAnswer @relation(fields: [homeworkAnswerId], references: [id], onDelete: Cascade)
  homeworkPuzzle HomeworkPuzzle @relation(fields: [homeworkPuzzleId], references: [id])

  @@unique([homeworkAnswerId, homeworkPuzzleId])
}